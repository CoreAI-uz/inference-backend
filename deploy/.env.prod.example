# Production config. Copy to deploy/.env.prod, replace every CHANGE_ME value,
# and keep the populated file off Git.

# --- Caddy ---
SITE_ADDRESS=chat.coreai.uz
API_SITE_ADDRESS=api.coreai.uz
ACME_EMAIL=admin@coreai.uz

# --- App ---
APP_ENV=production
DEBUG=false
WEB_CONCURRENCY=4

# --- Postgres (container + backend must agree) ---
POSTGRES_USER=coreai
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=coreai
DATABASE_URL=postgresql+asyncpg://coreai:CHANGE_ME_pg_password@postgres:5432/coreai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (in-country object store; dormant until the OCR track ships) ---
MINIO_ROOT_USER=coreai-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=coreai-minio
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_BUCKET=ocr-uploads
MINIO_SECURE=false

# --- Central LiteLLM and private inference workers ---
# Public cai_ keys never reach LiteLLM. This is a separate internal-only credential.
LITELLM_MASTER_KEY=sk-CHANGE_ME_internal_litellm_master_key
# Point these at the raw vLLM workers over the private network. Loopback SSH
# forwards are only for local development, not this deployed stack.
GEMMA_INFERENCE_BASE_URL=CHANGE_ME_gemma_worker_url
QWEN_INFERENCE_BASE_URL=CHANGE_ME_qwen_worker_url
VLLM_API_KEY=CHANGE_ME_raw_worker_key
# CoreAI's catalog and policy map routes only to the internal central LiteLLM.
MODELS_CONFIG={"gemma4-31b-it":{"endpoint":"http://litellm:4000/v1","served_model_name":"gemma4-31b-it","api_key":"os.environ/LITELLM_MASTER_KEY","max_context":16384,"display_name":"Gemma 4 31B","description":"Gemma 4 31B instruct — Uzbek, Russian, and English.","tags":["uzbek-russian"],"enabled":true},"qwen3.6-35b-a3b":{"endpoint":"http://litellm:4000/v1","served_model_name":"qwen3.6-35b-a3b","api_key":"os.environ/LITELLM_MASTER_KEY","max_context":16384,"display_name":"Qwen3 35B","description":"Qwen3 35B (A3B) — strong reasoning and coding.","tags":["reasoning"],"enabled":true,"supports_thinking":true}}
DEFAULT_MODEL_ID=gemma4-31b-it

# --- Identity / cookies ---
SESSION_SECRET=CHANGE_ME_session_secret_long_random
JWT_SECRET=CHANGE_ME_jwt_secret_long_random
API_KEY_PEPPER=CHANGE_ME_api_key_pepper_independent_long_random
MAX_API_KEYS_PER_USER=3
JWT_ALG=HS256
ACCESS_TOKEN_TTL_S=2592000
ANON_COOKIE_TTL_S=2592000
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=CHANGE_ME_google_web_client_id.apps.googleusercontent.com
GOOGLE_PENDING_TTL_S=600

# --- HTTP / proxy ---
CORS_ORIGINS=https://chat.coreai.uz,https://coreai.uz,https://www.coreai.uz
TRUSTED_PROXY=true
ALLOWED_HOSTS=chat.coreai.uz,api.coreai.uz,localhost,backend
INFERENCE_VERIFY_TLS=true
INFERENCE_HEALTH_CACHE_S=20

# --- Chat limits / safety (launch defaults — tune against real load + product) ---
MAX_CHAT_INPUT_CHARS=24000
RL_ANON_CHAT=5          # anon: burst of 5 chat messages, slow refill (~5/hour)
RL_USER_CHAT=60         # registered: 60 burst, ~60/hour refill
RL_SIGNUP_PER_IP=5      # account creations per IP (anti-farming)
RL_LOGIN_PER_IP=20      # login attempts per network, continuously refilled
RL_LOGIN_PER_ACCOUNT=10 # login attempts per account identifier, continuously refilled
MAX_QUEUE_WAIT_S=60
# Unclaimed anonymous conversations are swept after this many days.
ANON_CONV_RETENTION_DAYS=30
# Free-tier API request and response bodies are removed after this many days.
API_CONTENT_RETENTION_DAYS=30
CONV_SWEEP_INTERVAL_S=3600
AUTO_TITLE=true
TITLE_TIMEOUT_S=8
